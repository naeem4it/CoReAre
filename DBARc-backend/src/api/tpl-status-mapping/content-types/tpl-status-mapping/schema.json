{
  "kind": "collectionType",
  "collectionName": "tpl_status_mappings",
  "info": {
    "singularName": "tpl-status-mapping",
    "pluralName": "tpl-status-mappings",
    "displayName": "TPL Status Mapping",
    "description": "Maps external 3PL status codes to internal parcel statuses"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "partner": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::tpl-partner.tpl-partner"
    },
    "external_status_code": {
      "type": "string",
      "required": true
    },
    "internal_status": {
      "type": "enumeration",
      "enum": [
        "Total Booking",
        "Not Arrived",
        "Arrived",
        "Arrived At Destination",
        "Out For delivery",
        "Delivered",
        "Failed Attempt",
        "Ready To Return",
        "Return Dispatched",
        "Return to Shipper"
      ],
      "required": true
    }
  }
}