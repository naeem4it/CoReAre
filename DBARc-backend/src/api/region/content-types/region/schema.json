{
  "kind": "collectionType",
  "collectionName": "regions",
  "info": {
    "singularName": "region",
    "pluralName": "regions",
    "displayName": "Region",
    "description": "Geographical coverage zones, cities, states, and polygons"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "parent": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::region.region"
    },
    "name": {
      "type": "string",
      "required": true
    },
    "type": {
      "type": "string"
    },
    "geo_polygon": {
      "type": "json"
    },
    "cities": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::city.city",
      "inversedBy": "regions"
    },
    "courier": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::courier.courier",
      "inversedBy": "regions"
    },
    "tenant": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::tenant.tenant",
      "inversedBy": "default_regions"
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  }
}