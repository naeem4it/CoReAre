{
  "kind": "collectionType",
  "collectionName": "shippers",
  "info": {
    "singularName": "shipper",
    "pluralName": "shippers",
    "displayName": "Shipper",
    "description": "Ecommerce merchant shippers associated with tenants"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "tenant": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::tenant.tenant"
    },
    "couriers": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::courier.courier",
      "inversedBy": "shippers"
    },
    "name": {
      "type": "string",
      "required": true
    },
    "business_type": {
      "type": "string"
    },
    "api_key": {
      "type": "string",
      "unique": true
    },
    "webhook_url": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "default": "active"
    },
    "account_id": {
      "type": "string",
      "unique": true
    },
    "shipper_plan": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::shipper-plan.shipper-plan",
      "inversedBy": "shippers"
    },
    "pickup_locations": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::pickup-location.pickup-location",
      "mappedBy": "shipper"
    }
  }
}