{
  "kind": "collectionType",
  "collectionName": "couriers",
  "info": {
    "singularName": "courier",
    "pluralName": "couriers",
    "displayName": "Courier",
    "description": "Internal and 3PL courier/carrier partners"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "tenant": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::tenant.tenant"
    },
    "shippers": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::shipper.shipper",
      "mappedBy": "couriers"
    },
    "name": {
      "type": "string",
      "required": true
    },
    "contact_info": {
      "type": "json"
    },
    "api_enabled": {
      "type": "boolean",
      "default": false
    },
    "status": {
      "type": "string",
      "default": "active"
    },
    "courier_cities": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::courier-city.courier-city",
      "mappedBy": "couriers"
    },
    "parcel": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::parcel.parcel",
      "inversedBy": "courier"
    },
    "regions": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::region.region",
      "mappedBy": "courier"
    }
  }
}
