{
  "kind": "collectionType",
  "collectionName": "routes",
  "info": {
    "singularName": "route",
    "pluralName": "routes",
    "displayName": "Route",
    "description": "Operational courier delivery and pickup routes"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "route_code": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "name": {
      "type": "string",
      "required": true
    },
    "type": {
      "type": "enumeration",
      "enum": [
        "Delivery",
        "Pickup",
        "Return",
        "Special",
        "ThirdParty"
      ],
      "default": "Delivery"
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "Active",
        "Inactive"
      ],
      "default": "Active"
    },
    "description": {
      "type": "text"
    },
    "areas": {
      "type": "json"
    },
    "postal_codes": {
      "type": "text"
    },
    "office": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::office.office"
    },
    "city": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::city.city"
    },
    "zone": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::region.region"
    },
    "tenant": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::tenant.tenant"
    }
  }
}
