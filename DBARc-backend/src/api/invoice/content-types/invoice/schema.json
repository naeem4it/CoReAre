{
  "kind": "collectionType",
  "collectionName": "invoices",
  "info": {
    "singularName": "invoice",
    "pluralName": "invoices",
    "displayName": "Invoice",
    "description": "Shipper billing invoices"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "invoice_number": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "invoice_date": {
      "type": "date",
      "required": true
    },
    "period_start": {
      "type": "date"
    },
    "period_end": {
      "type": "date"
    },
    "total_charges": {
      "type": "decimal",
      "required": true
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "Paid",
        "Pending",
        "Overdue"
      ],
      "default": "Pending"
    },
    "cod_amount": {
      "type": "decimal",
      "default": 0
    },
    "ibft_charges": {
      "type": "decimal",
      "default": 100
    },
    "net_payable": {
      "type": "decimal",
      "default": 0
    },
    "target_payment_amount": {
      "type": "decimal"
    },
    "included_parcel_count": {
      "type": "integer",
      "default": 0
    },
    "excluded_parcel_count": {
      "type": "integer",
      "default": 0
    },
    "shipper": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::shipper.shipper"
    },
    "parcels": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::parcel.parcel",
      "mappedBy": "invoice"
    },
    "payment_method": {
      "type": "enumeration",
      "enum": [
        "Cash",
        "Cheque",
        "Online"
      ],
      "default": "Cash"
    },
    "cheque_number": {
      "type": "string"
    },
    "bank_name": {
      "type": "string"
    },
    "account_title": {
      "type": "string"
    },
    "account_number": {
      "type": "string"
    }
  }
}
