{
  "kind": "collectionType",
  "collectionName": "invoices",
  "info": {
    "singularName": "invoice",
    "pluralName": "invoices",
    "displayName": "Invoice",
    "description": "Shipper billing invoices"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "invoice_number": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "invoice_date": {
      "type": "date",
      "required": true
    },
    "period_start": {
      "type": "date"
    },
    "period_end": {
      "type": "date"
    },
    "total_charges": {
      "type": "decimal",
      "required": true
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "Paid",
        "Pending",
        "Overdue"
      ],
      "default": "Pending"
    },
    "shipper": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::shipper.shipper"
    }
  }
}
