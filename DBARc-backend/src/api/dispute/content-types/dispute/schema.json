      "target": "api::parcel.parcel"
    },
    "category": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "status": {
      "type": "string",
      "default": "open"
    },
    "resolution": {
      "type": "text"
    }
  }
}