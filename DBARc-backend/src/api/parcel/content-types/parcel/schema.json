{
  "kind": "collectionType",
  "collectionName": "parcels",
  "info": {
    "singularName": "parcel",
    "pluralName": "parcels",
    "displayName": "Parcel",
    "description": "Logistics parcel entities"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "tracking_number": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "status": {
      "type": "enumeration",
      "default": "Total Booking",
      "enum": [
        "Total Booking",
        "Not Arrived",
        "Arrived",
        "Arrived At Destination",
        "Out For delivery",
        "Delivered",
        "Failed Attempt",
        "Ready To Return",
        "Return Dispatched",
        "Return to Shipper"
      ]
    },
    "cod_amount": {
      "type": "decimal",
      "default": 0
    },
    "weight": {
      "type": "decimal",
      "required": true
    },
    "delivery_charges": {
      "type": "decimal",
      "required": true
    },
    "recipient_name": {
      "type": "string",
      "required": true
    },
    "recipient_phone": {
      "type": "string",
      "required": true
    },
    "recipient_address": {
      "type": "text",
      "required": true
    },
    "courier": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::courier.courier",
      "mappedBy": "parcel"
    },
    "courier_city": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::courier-city.courier-city",
      "mappedBy": "parcel"
    },
    "source_city": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::city.city"
    },
    "destination_city": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::city.city"
    },
    "consignee_email": {
      "type": "string"
    },
    "consignee_alt_phone": {
      "type": "string"
    },
    "allow_to_open": {
      "type": "enumeration",
      "default": "No",
      "enum": [
        "Yes",
        "No"
      ]
    },
    "comments": {
      "type": "text"
    },
    "pieces": {
      "type": "integer",
      "default": 1
    },
    "service_type": {
      "type": "enumeration",
      "enum": [
        "Overnight",
        "Second Day",
        "Rush",
        "Detained"
      ],
      "default": "Overnight"
    },
    "shipment_type": {
      "type": "enumeration",
      "enum": [
        "Parcel",
        "Document",
        "Flyer"
      ],
      "default": "Parcel"
    },
    "reference_number": {
      "type": "string"
    },
    "arrival_date": {
      "type": "datetime"
    },
    "delivered_date": {
      "type": "datetime"
    },
    "pickup_location": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::pickup-location.pickup-location"
    },
    "load_sheet": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::load-sheet.load-sheet",
      "inversedBy": "parcels"
    },
    "is_3pl": {
      "type": "boolean",
      "default": false
    },
    "origin_office": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::office.office"
    }
  }
}
